      message: "SUCCESS",
      target: [
        "id" => $entity->id(),
        "type" => mb_strtoupper($entity->bundle()),
        "name" => "Entity Deleted",
      ],
    ));
  }
}

/**
 * Implements hook_entity_update().
 */
function grants_audit_log__entity_update(EntityInterface $entity): void {

  // Trigger event only for users, webform nodes and webform submissions.
  if ($entity->getEntityTypeId() == "user" || ($entity->getEntityTypeId() == "node" && $entity->bundle() == "webform")) {
    \Drupal::service(AuditLogService::class)->logOperation(new AuditLogEvent(
      operation: "UPDATE",
      message: "SUCCESS",
      target: [
        "id" => $entity->id(),
        "type" => mb_strtoupper($entity->bundle()),
        "name" => "Entity Updated",
      ],
    ));
  }
}
