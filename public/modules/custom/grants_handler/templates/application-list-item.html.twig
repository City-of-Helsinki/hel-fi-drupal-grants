
{# Card actions for edit, delete, view and print application #}
{% set card_actions = [] %}

{% if (statusString == 'DRAFT') %}

  {% if editApplicationLink %}
    {% set card_actions = card_actions|merge([{
      label: "Edit"|t,
      aria_label: "Edit application @number, @name"|t({'@number': applicationNumber, '@name': applicationFormName}, {'context': 'grants_handler'}),
      url: editApplicationLink.url.toString(),
      icon: 'pen-line',
    }]) %}
  {% endif %}

  {% if deleteApplicationUrl %}
    {{ attach_library('grants_handler/application-delete-draft-dialog') }}
    {% set card_actions = card_actions|merge([{
      label: "Delete"|t,
      aria_label: "Delete application @number, @name"|t({'@number': applicationNumber, '@name': applicationFormName}, {'context': 'grants_handler'}),
      url: deleteApplicationUrl,
      icon: 'trash',
      class: 'js-delete-draft-link application-delete-link-' ~ applicationNumber,
    }]) %}
  {% endif %}

{% else %}

  {% if viewApplicationLink %}
    {% set card_actions = card_actions|merge([{
      label: "View"|t,
      aria_label: "View application @number, @name"|t({'@number': applicationNumber, '@name': applicationFormName}, {'context': 'grants_handler'}),
      url: viewApplicationLink.url.toString(),
      icon: 'eye',
    }]) %}
  {% endif %}

  {% if printApplicationUrl %}
    {% set card_actions = card_actions|merge([{
      label: "Print"|t,
      aria_label: "Print application @number, @name"|t({'@number': applicationNumber, '@name': applicationFormName}, {'context': 'grants_handler'}),
      url: printApplicationUrl,
      icon: 'printer',
    }]) %}
  {% endif %}

{% endif %}

{#Card tags for application status and new message#}
{% set status_colors = {
  SENT: 'info',
  SUBMITTED: 'info',
  RECEIVED: 'info',
  PREPARING: 'info',
  PENDING: 'info',
  PROCESSING: 'info',
  READY: 'success',
  RESOLVED: 'success',
  REJECTED: 'error',
  DELETED: 'error',
  CANCELED: 'error',
  CANCELLED: 'error',
  CLOSED: 'error',
} %}

{% set card_category_tag = [{
  tag: statusTag,
  color: status_colors[statusString|upper] ?? null,
}] %}

{% if (statusString == 'DRAFT' and errorType in ['NOT_OPEN', 'ARCHIVED']) %}
  {% set card_category_tag = card_category_tag|merge([{
    tag: errorType == 'ARCHIVED'
      ? "Application form expired"|t({}, {'context': 'grants_handler'})
      : "Application period ended"|t({}, {'context': 'grants_handler'}),
    color: 'alert',
  }]) %}
{% endif %}

{% if hasUnread == 'TRUE' %}
  {% set card_category_tag = card_category_tag|merge([{
    tag: hasUnreadText,
    color: 'alert',
  }]) %}
{% endif %}

{# Card metas for submitted time and application number #}
{% set submitted_content %}
  {{ applicationSubmitted }}
  <span class="application-list__item--submitted">{{ applicationSubmittedSortable }}</span>
{% endset %}

{% set application_number_content %}
  <span class="application-list__item--number application-list__item--application-number">{{ applicationNumber }}</span>
{% endset %}

{% set card_metas = [
  {
    icon: 'clock',
    label: statusString == 'DRAFT'
      ? "Draft saved time"|t({}, {'context': 'grants_handler'})
      : "Submission date"|t({}, {'context': 'grants_handler'}),
    content: submitted_content,
  },
  {
    icon: 'document',
    label: "Application number"|t({}, {'context': 'grants_handler'}),
    content: application_number_content,
  },
] %}

{% embed '@hdbt/component/card.twig' with {
  card_wrapper_element: 'li',
  card_modifier_class: 'card--border application-list__item ' ~ classes|default([])|join(' '),
  card_title_level: 'h3',
  card_title: applicationFormName,
  card_category_tag: card_category_tag,
  card_metas: card_metas,
  card_actions: card_actions,
} %}
{% endembed %}
