{
  "name": "hdbt_subtheme",
  "version": "1.2.0",
  "description": "Theme builder configuration for HDBT subtheme",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/hel-fi-drupal-grants",
  "@comment scripts": [
    "Every build, lint and format script below runs inside a disposable Node container via the sandbox command."
  ],
  "scripts": {
    "preinstall": "rm -rf node_modules/@hdbt/theme-builder && npm install ../../contrib/hdbt/theme-builder --loglevel=silent",
    "dev": "sandbox node theme-builder.mjs --watch --dev",
    "build": "sandbox sh -c 'npm run format:js --loglevel=silent && npm run lint --loglevel=silent && npm run validate-ts &&node theme-builder.mjs'",
    "postinstall": "npm --prefix ../../contrib/hdbt install --no-audit --progress=false --loglevel=silent",
    "lint:scss": "sandbox stylelint \"src/scss/**/*.scss\" --config node_modules/@hdbt/theme-builder/.stylelintrc.yaml --formatter string --fix",
    "lint:js": "sandbox biome lint --no-errors-on-unmatched src/js/",
    "format:js": "sandbox biome format --write --no-errors-on-unmatched src/js/",
    "lint": "sandbox npm-run-all --parallel lint:scss lint:js -s",
    "test": "sandbox vitest",
    "coverage": "sandbox vitest run --coverage",
    "validate-ts": "sandbox tsc --noEmit"
  },
  "dependencies": {
    "@hdbt/theme-builder": "file:../../contrib/hdbt/theme-builder",
    "@rjsf/core": "^5.24.3",
    "@rjsf/utils": "^5.24.3",
    "@rjsf/validator-ajv8": "^5.24.3",
    "@sentry/react": "^9.1.0",
    "ajv": "^8.17.1",
    "i18next": "^25.1.2",
    "jotai": "file:../../contrib/hdbt/node_modules/jotai",
    "npm-run-all2": "^8.0.4",
    "react": "file:../../contrib/hdbt/node_modules/react",
    "react-dom": "file:../../contrib/hdbt/node_modules/react-dom",
    "react-i18next": "^15.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/json-schema": "^7.0.15",
    "@types/react-router-dom": "^5.1.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false,
    "esbuild": false
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=24.0.0"
  },
  "overrides": {
    "svg-sprite": {
      "glob": "^13.0.0"
    }
  }
}
